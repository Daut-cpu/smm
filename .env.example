# ===== Обязательные =====
# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...
# Ключ Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Канал для публикации: @username или числовой id вида -100...
CHANNEL_ID=@my_kino_channel
# Telegram id администраторов через запятую (узнать: команда /myid у бота).
# ПУСТО = доступ у всех, обязательно заполните!
ADMIN_IDS=123456789

# ===== Чтение Telegram-каналов (отдельный, не личный аккаунт) =====
# Данные приложения с https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# Публичные каналы о кино через запятую (@username или ссылки t.me/...)
TG_CHANNELS=@channel_one,@channel_two
# Путь к файлу сессии (без .session); хранится только на сервере
TG_SESSION=data/reader

# ===== Источники и стиль =====
# RSS-ленты киносайтов через запятую. Пусто = стартовый набор из 6 сайтов
FEEDS=
# Описание стиля и аудитории канала для модели (дополняет образцы ниже)
CHANNEL_STYLE=Канал про кино и сериалы для широкой аудитории. Тон живой, с лёгким юмором.

# ===== Подача текста по образцу другого канала =====
# Канал, чью манеру письма копирует модель. Его последние посты читает аккаунт для чтения каналов
STYLE_CHANNEL=@piotrovskirenata
# Сколько последних постов брать как образцы (больше — точнее манера, но дороже запрос)
STYLE_EXAMPLES=15
# Файл со своими образцами, посты разделяются строкой ---  (необязательно)
STYLE_FILE=style_examples.txt
# Максимальная длина поста, знаков
POST_MAX_LEN=800
# Максимальный возраст новости, часов
MAX_AGE_HOURS=24
# Добавлять ссылку «Источник» (1 или 0)
SHOW_SOURCE=1

# ===== Ежедневная идея =====
# Время в формате ЧЧ:ММ; пусто = выключено
DAILY_TIME=10:00
TZ_NAME=Europe/Moscow

# ===== Модель =====
MODEL=claude-sonnet-5-5
# Глубина размышлений модели: low (быстрее, по умолчанию), medium, high
EFFORT=low
